@using Project.Web.Net.Mvc.ViewModels
@model List<ContentViewModel>

@foreach (var content in Model)
{
    <div class="card" style="width: 57rem;">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h5 class="card-title">@content.Topic</h5>
                <h6 class="card-subtitle mb-2 text-body-secondary">@content.Author</h6>
                <p class="card-text">@content.AuthorsOpinion</p>

                
                @if (content.LikeCount == null)
                {

                    <p class="card-text text-black"> 0 </p>
                }
                else {
                   <p class="card-text text-black"> @content.LikeCount </p>
                 }
                
                <a>@content.Date</a>

                <div class="align-middle">
                    @if (!String.IsNullOrEmpty(content.ImagePath)) {
                        

                            <img style="width:100px;height:100px" src="\images\@(content.ImagePath)" />
                        }
                        else
                        {
                            <img style="width:100px;height:100px" src="\images\pngtree-no-image-vector-illustration-isolated-png-image_1694547.jpg" />
                        } 
                    

                </div>

            </div>
           

            <div class="d-flex flex-column">
                <a asp-route="contentupdate_route" asp-route-id="@content.Id" class="btn btn-primary ms-3 mt-3">View</a>


                <a class="btn btn-danger ms-3 mt-3" asp-route="contentdelete_route" asp-route-id="@content.Id">Delete</a>
            </div>

        </div>
    </div>

    
}
