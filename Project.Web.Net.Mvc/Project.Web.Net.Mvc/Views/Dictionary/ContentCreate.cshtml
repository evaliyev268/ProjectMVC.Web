@using Project.Web.Net.Mvc.ViewModels
@model ContentViewModel




<form asp-controller="Dictionary" asp-action="Save" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2">
        <label class="form-label" asp-for="Topic">Topic</label>
        <input class="form-control" asp-for="Topic" />
        <span class="text-danger" asp-validation-for="Topic"></span>
    </div>
    <div class="mb-2">
        <label class="form-label" asp-for="Author">Author</label>
        <input class="form-control" asp-for="Author" />
        <span class="text-danger" asp-validation-for="Author"></span>
    </div>
    <div class="mb-2">
        <label class="form-label" asp-for="AuthorsOpinion">Opinion</label>
        <input class="form-control" asp-for="AuthorsOpinion" />
        <span class="text-danger" asp-validation-for="AuthorsOpinion"></span>
    </div>
    <div class="mb-2">
        <label class="form-label" asp-for="LikeCount">Like</label>
        <input class="form-control" asp-for="LikeCount" />
        <span class="text-danger" asp-validation-for="LikeCount"></span>
    </div>
    <div class="mb-2">
        <label class="form-label" asp-for="Date">Date</label>
        <input class="form-control" asp-for="Date" />
        <span class="text-danger" asp-validation-for="Date"></span>
    </div>
    <div class="mt-3 mb-3">
        <label asp-for="CategoryId">Category</label> <br />
        <select asp-for="CategoryId"
                asp-items="ViewBag.CategoryList"
                class="dropdown btn btn-info  mt-3">
            <option value="">-- Select Category --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Image" class="form-label" >Upload Image</label>
        <input class="form-control form-control-sm" asp-for="Image" type="file">
    </div>ton>
    <button class="btn btn-primary" type="submit">Send</but


    

</form>